config:
  bind: 0.0.0.0:25565
  onlineMode: true              # Gate fait l'auth Mojang ; le backend fait confiance
  forwarding:
    mode: modern                # secret partagé vérifié par FabricProxy-Lite
    velocitySecret: "${FORWARDING_SECRET}"

  servers:
    survie: minecraft:25565
  try: [survie]

  status:
    motd: |
      §6caffelatte §7— survie vanilla
      §7Java et Bedrock
    showMaxPlayers: {{ max_players | default(20) }}

  # Limites de connexion. Un serveur Minecraft public se fait scanner en continu ;
  # sans plafond, un scanner sature la poignée de main avant les vrais joueurs.
  compression:
    threshold: 256
  connectionTimeout: 5s
  readTimeout: 30s

# La config du plugin d'invitation n'est PAS ici : Gate désérialise ce fichier
# dans sa propre structure et ré-injecte le résultat dans viper, ce qui élimine
# toute clé qu'il ne connaît pas. Voir les Environment= de gate.container.
#
# LA LISTE BLANCHE DU SERVEUR EST ICI, DANS GATE, PAS DANS LE BACKEND.
# Le backend tourne avec white-list=false (containers/minecraft/entrypoint.sh)
# et c'est délibéré : son réseau podman est Internal=true, donc « whitelist add »
# ne peut pas résoudre un pseudo auprès de Mojang et échoue pour tout invité
# absent de son cache. Gate a l'egress et fait déjà l'auth Mojang (onlineMode
# ci-dessus) : il connaît le vrai UUID. Le plugin gate/internal/invitation
# refuse au LoginEvent tout joueur hors liste, et comme le backend n'est
# joignable QUE par Gate (aucun port publié), il n'existe aucun contournement.
# Si tu réactives white-list côté backend, plus personne d'invité n'entre.
