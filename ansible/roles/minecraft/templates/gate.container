[Unit]
Description=Gate — proxy Minecraft (binaire maison, plugin maintenance)
After=mc-network.service

[Container]
Image=ghcr.io/{{ github_org }}/gate:latest
ContainerName=gate
Network=mc.network
# Second réseau : Gate a besoin de l'egress pour l'auth Mojang.
Network=podman
PublishPort=25565:25565/tcp
Volume=%h/.config/gate:/etc/gate:ro,Z
Secret=forwarding_secret
Secret=floodgate_key
# Liste d'autorisation du serveur, portée par Gate lui-même. Volume PROPRE à
# Gate, surtout pas minecraft-data : Gate est le composant exposé à Internet,
# lui donner un accès en écriture aux données de jeu est exactement ce qu'on
# évite. La racine reste en lecture seule, ce volume est le seul point d'écriture.
Volume=gate-data.volume:/var/lib/gate:U,Z
# Témoin de maintenance : Gate y écrit quand les joueurs sont sortis, et
# mc-maintenance.sh sur l'hôte attend ce fichier avant de mettre à jour. Bind
# depuis l'hôte et pas dans gate-data : un volume podman nommé et rootless
# obligerait le script à faire un « podman volume inspect » pour trouver _data.
Volume=%h/maintenance:/run/maintenance:Z
# Config du plugin d'invitation. Elle passe par l'environnement et non par
# config.yml : Gate redésérialise son fichier dans sa propre struct et jette
# toute clé inconnue (pkg/gate/gate.go, fixedReadInConfig) — un plugin embarqué
# ne peut rien y lire.
# Plus de Secret=rcon_password : Gate ne parle plus RCON au backend, il tient
# la liste chez lui. Un secret de moins monté dans le conteneur exposé.
Environment=CAFFELATTE_PARRAINS={{ minecraft_parrains | join(',') }}
Environment=CAFFELATTE_PLAFOND_INVITATIONS={{ minecraft_plafond_invitations }}
# Administrateurs : peuvent révoquer n'importe quelle entrée avec /uninvite, y
# compris celle d'un parrain retiré de minecraft_parrains. Un parrain ordinaire
# ne révoque que ses propres invités. Vide = personne ne peut nettoyer les
# entrées orphelines.
Environment=CAFFELATTE_ADMINS={{ minecraft_admins | join(',') }}
Environment=CAFFELATTE_LISTE=/var/lib/gate/invitations.json
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=64M

[Service]
Restart=always
CPUWeight=200

[Install]
WantedBy=default.target
