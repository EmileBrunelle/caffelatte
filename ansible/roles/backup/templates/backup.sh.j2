#!/bin/bash
set -euo pipefail
export RESTIC_REPOSITORY="{{ restic_repo }}"
export RESTIC_PASSWORD_FILE=/run/secrets/restic_password
export AWS_ACCESS_KEY_ID="{{ restic_s3_key_id }}"
export AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/restic_s3_key

# Le monde Minecraft se sauvegarde à chaud : on fige les écritures le temps du
# snapshot, sinon on capture une région à moitié écrite (corruption silencieuse,
# qu'on ne découvre qu'au restore — c'est-à-dire au pire moment).
mc() { podman exec minecraft rcon-cli --password "$(cat /run/secrets/rcon_password)" "$@"; }
trap 'mc save-on || true' EXIT
mc save-off && mc save-all flush

restic backup /home/svc/.local/share/containers/storage/volumes --tag auto
restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune

# Une sauvegarde non vérifiée n'est pas une sauvegarde.
restic check --read-data-subset=5%
