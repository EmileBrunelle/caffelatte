# Image Minecraft maison : Fabric + mods serveur-only à parité vanilla.
# Pas d'image Minecraft tierce — seulement un JDK/JRE officiel comme base.
FROM registry.access.redhat.com/ubi10/openjdk-25:latest AS build
ARG MC_VERSION=26.2
ARG FABRIC_INSTALLER=1.1.2
# Mods serveur-only : ne changent AUCUN comportement de jeu, seulement la perf.
ARG MODS="fabric-api lithium ferrite-core krypton fabricproxy-lite chunky"

USER 0
# UBI, pas Debian : microdnf au lieu d'apt-get (curl et tar sont déjà présents,
# mais pas gzip, nécessaire pour décompresser l'archive rcon-cli).
RUN microdnf install -y jq gzip && microdnf clean all
WORKDIR /build

RUN curl -fsSL -o installer.jar \
      "https://maven.fabricmc.net/net/fabricmc/fabric-installer/${FABRIC_INSTALLER}/fabric-installer-${FABRIC_INSTALLER}.jar" \
 && java -jar installer.jar server -mcversion "${MC_VERSION}" -downloadMinecraft \
 && rm installer.jar

# Résolution des mods via l'API Modrinth, épinglée à la version de MC.
RUN mkdir -p mods && for slug in ${MODS}; do \
      url=$(curl -fsSL "https://api.modrinth.com/v2/project/${slug}/version?loaders=%5B%22fabric%22%5D&game_versions=%5B%22${MC_VERSION}%22%5D" \
            | jq -re '.[0].files[] | select(.primary) | .url') \
      && curl -fsSL -o "mods/${slug}.jar" "$url" \
      || { echo "ÉCHEC: ${slug} n'a pas de build pour ${MC_VERSION}"; exit 1; }; \
    done

# rcon-cli : c'est lui qui porte les avertissements en jeu avant un redémarrage.
ARG RCON_CLI=1.7.7
# UBI n'a pas dpkg : on mappe uname -m vers les noms d'archive Go (amd64/arm64).
RUN case "$(uname -m)" in \
      x86_64) arch=amd64 ;; \
      aarch64) arch=arm64 ;; \
      *) echo "architecture non supportée: $(uname -m)"; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/itzg/rcon-cli/releases/download/${RCON_CLI}/rcon-cli_${RCON_CLI}_linux_${arch}.tar.gz" \
    | tar xz rcon-cli

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:latest
LABEL org.opencontainers.image.source="https://github.com/caffelatte/caffelatte"
# Auto-update natif de Podman : `podman auto-update` suit le registre.
LABEL io.containers.autoupdate=registry

USER 0
RUN useradd -u 10000 -r -m -d /data minecraft
COPY --from=build /build/fabric-server-launch.jar /build/server.jar /opt/mc/
COPY --from=build /build/libraries /opt/mc/libraries
COPY --from=build /build/mods /opt/mc/mods
COPY --from=build /build/rcon-cli /usr/local/bin/rcon-cli
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

USER minecraft
WORKDIR /data
VOLUME /data
EXPOSE 25565 25575
# Le healthcheck interroge le serveur via RCON : un JVM vivant mais figé est détecté.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s \
  CMD rcon-cli --password "$(cat /run/secrets/rcon_password)" list || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
